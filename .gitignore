# Local Pi runtime state
.atl/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.python-version   # written by `pyenv local` (README, Apple Silicon Option A)

# Packaging build leftovers (python -m build)
build/
dist/
*.egg-info/

# Large local data / generated artifacts (regenerable, not versioned)
data/
Trained copy/
docs/*.pdf

# HTCondor job logs (submit files are versioned, logs are not)
htcondor/logs/*
!htcondor/logs/.gitkeep

# Google Drive's duplicate-name download marker, e.g.
# out_elong-20261015T162906Z-1-001.zip. When the same run is also present
# as a directory (Trained/out_elong/), the zip is a byte-identical copy.
# Scoped to Trained/ so it cannot hide artifacts elsewhere.
Trained/
