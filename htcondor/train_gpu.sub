# GPU variant of train.sub (A100/H100/V100 are HTCondor-only)
# Verificar antes: condor_status -af Name GPUs_Capability
# y que el CUDA del nodo coincida con el build de TensorFlow.

universe = vanilla

USERDIR = /home/nmrbox/0070/abolanos/git/mrai_p3

executable = $(USERDIR)/htcondor/run_train.sh
arguments  = $(RunName) $(Pool) $(Extra)

RunName = out_nmrbox_gpu
Pool    = pre_aniso_f2lo0_3268_f2hi4_a25
Extra   =

log    = $(USERDIR)/htcondor/logs/$(RunName).$(Cluster).$(Process).log
output = $(USERDIR)/htcondor/logs/$(RunName).$(Cluster).$(Process).out
error  = $(USERDIR)/htcondor/logs/$(RunName).$(Cluster).$(Process).err

getenv                = True
should_transfer_files = NO
transfer_executable   = FALSE

Threads = 8
environment = "MRAI_THREADS=$(Threads)"

request_cpus   = $(Threads)
request_memory = 16GB
request_disk   = 16GB
request_gpus   = 1

# Ajustar segun el pool: CUDACapability >= 7 (Volta) suele bastar para TF.
requirements = (GPUs > 0) && (CUDACapability >= 7.0)

+Production = True

queue
